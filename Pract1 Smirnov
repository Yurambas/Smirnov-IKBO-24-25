Задача 5. Регистрация пользовательской команды в /usr/local/bin (скрипт reg)

reg:
#!/usr/bin/env bash
set -euo pipefail

target="${1:?Использование: $0 <файл_скрипта>}"

if [ ! -f "$target" ]; then
    echo "Ошибка: файл $target не найден" >&2
    exit 1
fi

chmod +x "$target"
if [ "$(id -u)" -eq 0 ]; then
    cp "$target" /usr/local/bin/
else
    sudo cp "$target" /usr/local/bin/
fi
echo "Команда $target успешно установлена в /usr/local/bin"

