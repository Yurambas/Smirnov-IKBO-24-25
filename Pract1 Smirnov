Задача 6. Проверка наличия комментария в первой строке (*.c, *.js, *.py)

check_comment.sh:
#!/usr/bin/env bash
dir="${1:-.}"

find "$dir" -type f \( -name "*.c" -o -name "*.js" -o -name "*.py" \) | while read -r f; do
    first_line=$(head -n 1 "$f" 2>/dev/null || true)
    case "$f" in
        *.c|*.js)
            if [[ "$first_line" =~ ^[[:space:]]*(\/\/|\/\*) ]]; then
                echo "[OK]  $f"
            else
                echo "[NO]  $f"
            fi
            ;;
        *.py)
            if [[ "$first_line" =~ ^[[:space:]]*# ]]; then
                echo "[OK]  $f"
            else
                echo "[NO]  $f"
            fi
            ;;
    esac
done

./check_comment.sh .

[OK]  ./test_with_comm.c
[NO]  ./test_no_comm.js
[OK]  ./test_shebang.py

