Задача 7. Нахождение файлов-дубликатов по содержимому

find_duplicates.sh:
#!/usr/bin/env bash
dir="${1:-.}"

find "$dir" -type f -exec sha256sum {} + 2>/dev/null | \
    sort | \
    awk '{
        hash = $1
        $1 = ""
        sub(/^[ \t]+/, "")
        files[hash] = files[hash] ? files[hash] "\n  " $0 : $0
        count[hash]++
    }
    END {
        for (h in count) {
            if (count[h] > 1) {
                print "Hash: " h "\n  " files[h] "\n"
            }
        }
    }'

