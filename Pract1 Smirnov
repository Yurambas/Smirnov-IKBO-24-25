Задача 10. Названия пустых текстовых файлов в указанной директории

empty_text_files.sh:
#!/usr/bin/env bash
dir="${1:?Укажите директорию}"

find "$dir" -maxdepth 1 -type f -empty -exec sh -c '
    for f do
        mime=$(file -b --mime-type "$f")
        if [ "$mime" = "text/plain" ] || [ "$mime" = "inode/x-empty" ]; then
            basename "$f"
        fi
    done
' sh {} +

